# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Trên VPS: chmod 600 .env. Sinh chuỗi ngẫu nhiên: openssl rand -hex 32
# (Dùng hex cho mật khẩu DB để không có ký tự đặc biệt làm hỏng DATABASE_URL.)

# --- Tên miền và URL ---
# Local: DOMAIN=localhost, APP_URL=https://localhost
# Production: tên miền thật (bắt buộc cho HTTPS, OAuth Google/Facebook, micro)
DOMAIN=localhost
APP_URL=https://localhost
# Chỉ production: bật HSTS. Local dùng docker-compose.dev.yml nên không cần đặt.
# HSTS_HEADER=max-age=31536000

# --- Tag image, dùng để rollback ---
# IMAGE_TAG=latest

# --- PostgreSQL ---
DB_USER=app
DB_PASSWORD=change-me-db-password
DB_NAME=app

# --- Redis và Qdrant (không mở ra internet, vẫn đặt mật khẩu) ---
REDIS_PASSWORD=change-me-redis-password
QDRANT_API_KEY=change-me-qdrant-key

# --- Backend ---
SESSION_SECRET=change-me-session-secret
RESEND_API_KEY=change-me

# --- OAuth (mỗi môi trường một client riêng, redirect URI khớp từng ký tự) ---
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
FACEBOOK_APP_ID=change-me
FACEBOOK_APP_SECRET=change-me
